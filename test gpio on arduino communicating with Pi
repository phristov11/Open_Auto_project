// === Volume Encoder Pins ===
#define VOL_CLK 2
#define VOL_DT  3
#define VOL_BTN 4

// === Media Encoder Pins ===
#define MEDIA_CLK 5
#define MEDIA_DT  6
#define MEDIA_BTN 7

// === Encoder states ===
int lastVolCLK = HIGH;
int lastMediaCLK = HIGH;
int lastVolBtn = HIGH;
int lastMediaBtn = HIGH;

void setup() {
  Serial.begin(9600); // Nano Old Bootloader → 9600 baud

  pinMode(VOL_CLK, INPUT);
  pinMode(VOL_DT, INPUT);
  pinMode(VOL_BTN, INPUT_PULLUP);

  pinMode(MEDIA_CLK, INPUT);
  pinMode(MEDIA_DT, INPUT);
  pinMode(MEDIA_BTN, INPUT_PULLUP);

  Serial.println("Nano Encoder Control started...");
}

void loop() {
  // --- Volume Encoder ---
  int volCLK = digitalRead(VOL_CLK);
  int volDT  = digitalRead(VOL_DT);

  if (volCLK != lastVolCLK && volCLK == LOW) {
    if (volDT != volCLK) Serial.println("VOL_UP");
    else Serial.println("VOL_DOWN");
  }
  lastVolCLK = volCLK;

  // Volume button (MUTE)
  int volBtn = digitalRead(VOL_BTN);
  if (volBtn == LOW && lastVolBtn == HIGH) {
    Serial.println("MUTE");
    delay(200); // debounce
  }
  lastVolBtn = volBtn;

  // --- Media Encoder ---
  int mediaCLK = digitalRead(MEDIA_CLK);
  int mediaDT  = digitalRead(MEDIA_DT);

  if (mediaCLK != lastMediaCLK && mediaCLK == LOW) {
    if (mediaDT != mediaCLK) Serial.println("NEXT");
    else Serial.println("PREV");
  }
  lastMediaCLK = mediaCLK;

  // Media button (PLAY/PAUSE)
  int mediaBtn = digitalRead(MEDIA_BTN);
  if (mediaBtn == LOW && lastMediaBtn == HIGH) {
    Serial.println("PLAY_PAUSE");
    delay(200); // debounce
  }
  lastMediaBtn = mediaBtn;
}
