🔹 Arduino код (пример за 2 енкодера + бутони)

#include <Encoder.h>

// Volume encoder pins
#define VOL_CLK 2
#define VOL_DT 3
#define VOL_BTN 4

// Media encoder pins
#define MEDIA_CLK 5
#define MEDIA_DT 6
#define MEDIA_BTN 7

Encoder volEnc(VOL_CLK, VOL_DT);
Encoder mediaEnc(MEDIA_CLK, MEDIA_DT);

long volLast = 0;
long mediaLast = 0;

void setup() {
  Serial.begin(115200);

  pinMode(VOL_BTN, INPUT_PULLUP);
  pinMode(MEDIA_BTN, INPUT_PULLUP);
}

void loop() {
  // Volume encoder
  long volNew = volEnc.read() / 4; // делим, за да е по-стабилно
  if (volNew > volLast) {
    Serial.println("VOL_UP");
    volLast = volNew;
  } else if (volNew < volLast) {
    Serial.println("VOL_DOWN");
    volLast = volNew;
  }

  // Media encoder
  long mediaNew = mediaEnc.read() / 4;
  if (mediaNew > mediaLast) {
    Serial.println("NEXT");
    mediaLast = mediaNew;
  } else if (mediaNew < mediaLast) {
    Serial.println("PREV");
    mediaLast = mediaNew;
  }

  // Buttons
  if (digitalRead(VOL_BTN) == LOW) {
    Serial.println("MUTE");
    delay(200); // debounce
  }
  if (digitalRead(MEDIA_BTN) == LOW) {
    Serial.println("PLAY_PAUSE");
    delay(200);
  }
}
Това е за Arduino Uno/Nano/Mega. Ако имаш Leonardo/Pro Micro, пак става.

