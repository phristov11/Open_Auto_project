import alsaaudio
from pynput.keyboard import Controller
import serial
from time import sleep

# Настрой си порта (провери с `dmesg | grep tty`)
ser = serial.Serial('/dev/ttyACM0', 115200, timeout=1)

# Keyboard controller
keyboard = Controller()

# Volume control setup
mixer = alsaaudio.Mixer('Master')
vol_step = 5
max_vol = 100
min_vol = 0
last_vol = mixer.getvolume()[0]
muted = False

print("Serial Volume + Media Control started...")

while True:
    line = ser.readline().decode().strip()
    if not line:
        continue

    if line == "VOL_UP":
        current_vol = mixer.getvolume()[0]
        new_vol = min(current_vol + vol_step, max_vol)
        mixer.setvolume(new_vol)
        print("Volume Up:", new_vol)

    elif line == "VOL_DOWN":
        current_vol = mixer.getvolume()[0]
        new_vol = max(current_vol - vol_step, min_vol)
        mixer.setvolume(new_vol)
        print("Volume Down:", new_vol)

    elif line == "MUTE":
        if muted:
            mixer.setvolume(last_vol)
            print("Unmuted:", last_vol)
        else:
            last_vol = mixer.getvolume()[0]
            mixer.setvolume(0)
            print("Muted")
        muted = not muted

    elif line == "NEXT":
        print("Next Song: N")
        keyboard.press('n')
        keyboard.release('n')

    elif line == "PREV":
        print("Previous Song: V")
        keyboard.press('v')
        keyboard.release('v')

    elif line == "PLAY_PAUSE":
        print("Play/Pause: P")
        keyboard.press('p')
        keyboard.release('p')

    sleep(0.01)  # малък delay за да не товари CPU
